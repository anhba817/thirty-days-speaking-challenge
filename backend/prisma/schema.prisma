generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  googleId      String         @unique
  email         String         @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  // When set, the account is scheduled for permanent deletion at this time
  // (deletion-request time + 30-day grace period). Cleared if the user signs
  // in again before then. A daily job purges accounts once this is in the past.
  deletionScheduledAt DateTime?
  completedDays CompletedDay[]
  attempts      Attempt[]

  @@index([deletionScheduledAt])
}

model CompletedDay {
  userId      String
  dayId       Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dayId])
}

model Attempt {
  id            String   @id @default(cuid())
  userId        String
  dayId         Int
  questionIx    Int
  transcript    String?
  feedback      Json
  score         Float
  audioKey      String?
  audioMimeType String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayId])
}
